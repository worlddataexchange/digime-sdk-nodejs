{
    "name": "@worlddataexchange/digime-sdk-nodejs",
    "version": "18.0.4-rc.1",
    "description": "Node.JS SDK for digi.me",
    "main": "dist/main/index.js",
    "types": "dist/main/index.d.ts",
    "module": "dist/module/index.js",
    "scripts": {
        "build": "npm run clear-dist && npm run compile",
        "compile": "npm run compile:main && npm run compile:module",
        "compile:main": "./node_modules/.bin/tsc -p tsconfig.dist.json",
        "compile:module": "./node_modules/.bin/tsc -p tsconfig.module.json",
        "clear-dist": "rimraf ./dist",
        "lint": "eslint . --max-warnings=0",
        "lint-fix": "eslint . --fix",
        "test": "./node_modules/.bin/jest --coverage --silent=false --config=jest-config.json",
        "version": "node ./tools/update-sdk-version.ts",
        "generate-docs": "./node_modules/.bin/typedoc --tsconfig tsconfig.dist.json",
        "preversion": "npm run test && npm run lint"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/worlddataexchange/digime-sdk-nodejs.git"
    },
    "author": "digi.me Limited",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/worlddataexchange/digime-sdk-nodejs/issues"
    },
    "homepage": "https://github.com/worlddataexchange/digime-sdk-nodejs#readme",
    "devDependencies": {
        "@eslint/js": "~10.0.1",
        "@types/jest": "~30.0.0",
        "@types/jsonwebtoken": "~9.0.10",
        "@types/node": "~24.19.0",
        "eslint": "~10.11.0",
        "eslint-config-prettier": "~10.1.8",
        "eslint-plugin-headers": "~1.3.4",
        "eslint-plugin-prettier": "~5.5.6",
        "eslint-plugin-unicorn": "~76.0.0",
        "jest": "~30.5.2",
        "jest-circus": "~30.5.2",
        "nock": "~14.0.17",
        "prettier": "~3.9.9",
        "rimraf": "~6.1.3",
        "ts-jest": "~29.4.14",
        "typedoc": "~0.28.20",
        "typedoc-plugin-missing-exports": "~4.1.4",
        "typescript": "~6.0.3",
        "typescript-eslint": "~8.71.0"
    },
    "dependencies": {
        "fp-ts": "~2.16.11",
        "got": "~11.8.6",
        "io-ts": "~2.2.22",
        "jsonwebtoken": "~9.0.3"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.0.0"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=10.0.0"
        }
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true,
        "fsevents@2.3.3": true,
        "@parcel/watcher@2.6.0": true
    }
}
